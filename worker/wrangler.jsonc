{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pi-agent-filed",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // wrangler tail misses what DOs log after an RPC returns, where the model, the container and Slack replies run.
  "observability": { "enabled": true },
  "containers": [
    {
      // Only the durable_object policy can snapshot, and a policy is fixed per application, so this is a new one.
      "name": "pi-agent-filed-workspace",
      "class_name": "Workspace",
      "scheduling_policy": "durable_object",
      "images": { "base": { "dockerfile": "./sandbox.Dockerfile" } },
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SESSIONS", "class_name": "Session" },
      { "name": "SANDBOX", "class_name": "Workspace" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Session", "Sandbox"] },
    { "tag": "v2", "new_sqlite_classes": ["Workspace"] },
  ],
}
